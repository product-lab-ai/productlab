+import { AGENT_ENGINE_VERSION, programProblem, type AgentProgram } from "../engine/agent-loop";
+
+export const recoveryMode = import.meta.env.VITE_LESSON_RECOVERY;
+export const recoveryEnabled = recoveryMode === "bookmark" || recoveryMode === "draft";
+export type RecoveryScope = { key: string; signature: string };
+type RecoveryStorage = Pick<Storage, "getItem" | "setItem" | "removeItem">;
+
+export function recoveryScope<L extends { id: string }>(course: string, lesson: L): RecoveryScope {
+  return {
+    key: `workings-recovery-v1:${JSON.stringify([course, lesson.id])}`,
+    // Match the complete content and engine, including edits without a revision bump.
+    signature: JSON.stringify([AGENT_ENGINE_VERSION, lesson]),
+  };
+}
+
+function read(storage: RecoveryStorage, scope: RecoveryScope, suffix: string): unknown {
+  try {
+    const record = JSON.parse(storage.getItem(scope.key + suffix) ?? "null");
+    return record?.signature === scope.signature ? record.value : null;
+  } catch { return null; }
+}
+
+export function saveRecovery(storage: RecoveryStorage, scope: RecoveryScope, suffix: string, value: unknown): boolean {
+  try {
+    storage.setItem(scope.key + suffix, JSON.stringify({ signature: scope.signature, value }));
+    return true;
+  } catch { return false; }
+}
+
+export function readPosition(storage: RecoveryStorage, scope: RecoveryScope, beats: { id: string; kind: string }[]): number {
+  const id = read(storage, scope, ":position");
+  const index = beats.findIndex((beat) => beat.id === id && beat.kind !== "free-play");
+  return index < 0 ? 0 : index;
+}
+
+export function readDraft(storage: RecoveryStorage, scope: RecoveryScope, beat: { id: string; program: AgentProgram; editable: (keyof AgentProgram)[] }): AgentProgram | null {
+  const value = read(storage, scope, `:draft:${beat.id}`);
+  if (programProblem(value) !== null) return null;
+  const program = value as AgentProgram;
+  for (const key of Object.keys(beat.program) as (keyof AgentProgram)[]) {
+    if (typeof program[key] !== typeof beat.program[key]) return null;
+    if (!beat.editable.includes(key) && program[key] !== beat.program[key]) return null;
+  }
+  return { ...program };
+}
