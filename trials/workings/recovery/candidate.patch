+import { describe, expect, it } from "vitest";
+import { workingProgram } from "../engine/agent-loop";
+import { readDraft, readPosition, recoveryScope, saveRecovery } from "./lesson-recovery";
+
+function memory() {
+  const values = new Map<string, string>();
+  return {
+    getItem: (key: string) => values.get(key) ?? null,
+    setItem: (key: string, value: string) => { values.set(key, value); },
+    removeItem: (key: string) => { values.delete(key); },
+  };
+}
+const lesson = { id: "tools", revision: 1, title: "Tools" };
+const scope = recoveryScope("ai", lesson);
+const beat = { id: "repair", program: workingProgram, editable: ["observation"] as const };
+const editableBeat = { ...beat, editable: [...beat.editable] };
+const beats = [{ id: "intro", kind: "teach" }, { id: "repair", kind: "play" }, { id: "end", kind: "free-play" }];
+
+describe("lesson recovery", () => {
+  it("restores an unfinished place and actual draft without a grade", () => {
+    const storage = memory();
+    saveRecovery(storage, scope, ":position", "repair");
+    const draft = { ...workingProgram, observation: "wrong-id" as const };
+    saveRecovery(storage, scope, ":draft:repair", draft);
+    expect(readPosition(storage, scope, beats)).toBe(1);
+    expect(readDraft(storage, scope, editableBeat)).toEqual(draft);
+    expect(readDraft(storage, scope, editableBeat)).not.toHaveProperty("passed");
+  });
+  it("separates courses and invalidates content even without a revision bump", () => {
+    const storage = memory();
+    saveRecovery(storage, scope, ":position", "repair");
+    saveRecovery(storage, scope, ":draft:repair", workingProgram);
+    for (const other of [recoveryScope("ansible", lesson), recoveryScope("ai", { ...lesson, title: "Changed" })]) {
+      expect(readPosition(storage, other, beats)).toBe(0);
+      expect(readDraft(storage, other, editableBeat)).toBeNull();
+    }
+  });
+  it("refuses corrupt data and unsupported or locked operations", () => {
+    const storage = memory();
+    storage.setItem(scope.key + ":draft:repair", "{");
+    expect(readDraft(storage, scope, editableBeat)).toBeNull();
+    for (const invalid of [
+      { ...workingProgram, maxTurns: 99 },
+      { ...workingProgram, dispatch: "stop" },
+      { ...workingProgram, observation: ["append"] },
+      { ...workingProgram, passed: true },
+    ]) {
+      saveRecovery(storage, scope, ":draft:repair", invalid);
+      expect(readDraft(storage, scope, editableBeat)).toBeNull();
+    }
+  });
+  it("does not restore an unknown step or the completion destination", () => {
+    const storage = memory();
+    for (const id of ["end", "missing", 2, null]) {
+      saveRecovery(storage, scope, ":position", id);
+      expect(readPosition(storage, scope, beats)).toBe(0);
+    }
+  });
+  it("ignores an old engine binding", () => {
+    const storage = memory();
+    saveRecovery(storage, { ...scope, signature: "old engine" }, ":draft:repair", workingProgram);
+    expect(readDraft(storage, scope, editableBeat)).toBeNull();
+  });
+  it("returns failure when storage is unavailable", () => {
+    const storage = { getItem() { throw Error("blocked"); }, setItem() { throw Error("full"); }, removeItem() {} };
+    expect(saveRecovery(storage, scope, ":position", "repair")).toBe(false);
+    expect(readPosition(storage, scope, beats)).toBe(0);
+    expect(readDraft(storage, scope, editableBeat)).toBeNull();
+  });
+});
